#!/usr/bin/env bash

# Where a coding agent's context goes in this repo: what the repo itself adds,
# what it inherits from the agent's home and its plugins, and how much of that is
# resident before you type anything. On its own it puts a line up for each
# harness installed, -a opens one of them, a further argument opens a group

set -e

# Three bytes a token, measured against /context over seventeen skills whose
# descriptions ship in full: 1,790 real tokens against 5,420 bytes. Description
# prose is denser than the four bytes a token usually quoted
BYTES_PER_TOKEN=3

# Byte counts, not character counts, and awk that does not choke on a binary
# asset sitting in a skill directory
export LC_ALL=C

command -v jq >/dev/null || {
  printf 'agent-ctx needs jq to read settings and plugin files. Install it with: brew install jq\n' >&2
  exit 1
}

RESET=$'\033[0m'
BRIGHT=$'\033[1m'
GRAY=$'\033[90m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
CYAN=$'\033[36m'
# Cells sit on a dim background so the half block has no gap on its right
BG=$'\033[48;5;236m'

usage() {
  cat <<'USAGE'
usage: agent-ctx [-a claude|codex] [-w window] [-v] [--prompt] [group]

  no argument   one line per harness installed here
  -a            that harness in full: what each directory puts in context
  group         part of a group name from that table, to list its items
  -v            list the items inside every group of that table
  -w            window the always total is drawn against, default 200k
  --prompt      block by block, what codex would send from here
USAGE
}

agent=claude
window=200k
agents=(claude codex)

# getopts is short options only, so this one is taken out of the way first
show_prompt=0
agent_set=0
verbose=0
args=()
for arg in "$@"; do
  case $arg in
    --prompt) show_prompt=1 ;;
    *) args+=("$arg") ;;
  esac
done
set -- "${args[@]}"

while getopts ':a:w:hv' opt; do
  case $opt in
    a) agent=$OPTARG agent_set=1 ;;
    v) verbose=1 ;;
    w) window=$OPTARG ;;
    h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

# 200k and 1m are easier to type than the digits and easier to read back, so the
# bar is labelled with what was typed and measured against what it expands to
window_label=$window
window=${window//[kK]/000}
window=${window//[mM]/000000}
[[ $window =~ ^[0-9]+$ ]] && ((window > 0)) || {
  printf 'unreadable window %s. Try 200k, 1m, or a token count\n' "$window_label" >&2
  exit 1
}
filter=${1:-}
repo=$PWD

# targets is section|label|kind|dir. kind is how an item maps to files: under
# skills an item is a directory holding SKILL.md, elsewhere each .md file is its
# own item. collect() resets it, and everything else discovery fills it in
add_target() { [[ -d $4 ]] && targets+=("$1|$2|$3|$4"); return 0; }

add_tree() { # section label_prefix dir
  add_target "$1" "$2 skills" skills "$3/skills"
  add_target "$1" "$2 commands" flat "$3/commands"
  add_target "$1" "$2 prompts" flat "$3/prompts"
  add_target "$1" "$2 agents" flat "$3/agents"
}

# What a memory file costs is what survives its load. Claude drops the
# frontmatter and every HTML comment that stands on its own, verified against a
# session that loaded one, and Codex keeps both, verified with codex debug
# prompt-input. An inline comment mid-paragraph survives either way
strip_memory=0

# Claude reserves one percent of the window for the skill listing, in characters
# against its own four bytes a token, and shortens descriptions to fit once the
# listing runs over. Codex has a budget of its own but does not say how large
listing_cap=0

# Codex names the file each skill came from in its listing, Claude does not
skill_locator=0

memory_tokens() { # file
  ((strip_memory)) || {
    printf '%d\n' "$(($(wc -c <"$1") / BYTES_PER_TOKEN))"
    return 0
  }
  awk -v b="$BYTES_PER_TOKEN" '
    NR == 1 && /^---[ \t]*$/ { fm = 1; next }
    fm { if (/^---[ \t]*$/) fm = 0; next }
    /^[ \t]*<!--/ { open = 1 }
    open {
      if (!/-->/) next
      open = 0
      sub(/^.*-->/, "")
      if (/^[ \t]*$/) next
    }
    { n += length($0) + 1 }
    END { print int(n / b) }
  ' "$1"
}

# A memory file is resident in full, and an @path line in one pulls that file in
# too. One level of import is as far as this looks
add_memory() { # section file
  [[ -f $2 ]] || return 0
  memory+=("$1|$2")
  local import
  while read -r import; do
    import=$(cd "$(dirname "$2")" && cd "$(dirname "$import")" 2>/dev/null && pwd)/$(basename "$import")
    [[ -f $import ]] && memory+=("$1|$import")
  done < <(grep -o '^@[^ ]*' "$2" 2>/dev/null | cut -c2-)
  return 0
}

# Every directory an agent reads memory from, outermost first: from $1 up to $2,
# or to just below / for an agent that keeps going past the repo
memory_dirs() { # innermost outermost
  local dir=$1 out=()
  while [[ $dir != / ]]; do
    out=("$dir" "${out[@]}")
    [[ $dir == "$2" ]] && break
    dir=${dir%/*}
    [[ -n $dir ]] || dir=/
  done
  printf '%s\n' "${out[@]}"
}

# TOML section names under a prefix, dropping any the file switches off. Codex
# uses these for both its servers and its plugins
toml_sections() { # prefix file
  [[ -f $2 ]] || return 0
  awk -v p="$1" '
    /^[ \t]*\[/ {
      if (name != "" && !off) print name
      name = ""; off = 0
      if (index($0, "[" p) == 1) {
        name = substr($0, length(p) + 2)
        sub(/\][ \t]*$/, "", name)
        gsub(/"/, "", name)
      }
      next
    }
    /^[ \t]*enabled[ \t]*=[ \t]*false/ { off = 1 }
    END { if (name != "" && !off) print name }
  ' "$2"
}

discover_claude() {
  local user f style dir name disabled section settings=() mcp_files=()
  user=$(agent_home claude)

  strip_memory=1
  # one percent of the window, and never less than a token of it, the way claude
  # floors its own budget
  listing_cap=$((window / 100))
  ((listing_cap)) || listing_cap=1
  add_tree 1 project "$repo/.claude"

  # CLAUDE.md, its .local companion and AGENTS.md are discovered together, in
  # every directory from the cwd up to just below /. One above the repo loads in
  # every project under it, which makes it inherited rather than this repo's
  while read -r dir; do
    section=2
    [[ $dir == "$root" || $dir == "$root"/* ]] && section=1
    add_memory "$section" "$dir/CLAUDE.md"
    add_memory "$section" "$dir/CLAUDE.local.md"
    add_memory "$section" "$dir/AGENTS.md"
  done < <(memory_dirs "$cwd" "")
  [[ -f "$repo/.mcp.json" ]] && mcp_files+=("$repo/.mcp.json")
  for f in "$repo/.claude/settings.json" "$repo/.claude/settings.local.json" "$user/settings.json"; do
    [[ -f $f ]] || continue
    settings+=("$f")
    hook_files+=("${f/#$HOME/\~}|$f")
    grep -q '"statusLine"' "$f" && extra_events+=("statusline	${f/#$HOME/\~}")
  done

  add_tree 2 user "$user"
  add_memory 2 "$user/CLAUDE.md"

  # An output style rewrites the system prompt, so the active one is resident and
  # the rest of the directory is not
  for f in "${settings[@]}"; do
    style=$(jq -r '.outputStyle // empty' "$f" 2>/dev/null) || true
    [[ -n $style ]] || continue
    for dir in "$repo/.claude/output-styles" "$user/output-styles"; do
      add_memory 2 "$dir/$style.md"
    done
  done

  # installed_plugins.json names the version actually installed. The cache keeps
  # older versions beside it, so globbing the cache counts each one again.
  # One file per jq, so a settings file someone has broken costs only its own
  # entries rather than every file after it
  disabled=$(for f in "${settings[@]}"; do
    jq -r '.enabledPlugins // {} | to_entries[] |
      select(.value == false) | .key | split("@")[0]' "$f" 2>/dev/null
  done) || true
  while read -r dir; do
    [[ -d $dir ]] || continue
    name=$(basename "$(dirname "$dir")")
    grep -qxF "$name" <<<"$disabled" && continue
    add_tree 2 "plugin $name" "$dir"
    [[ -f "$dir/.mcp.json" ]] && mcp_files+=("$dir/.mcp.json")
    [[ -f "$dir/mcp.json" ]] && mcp_files+=("$dir/mcp.json")
    [[ -f "$dir/hooks/hooks.json" ]] && hook_files+=("plugin $name|$dir/hooks/hooks.json")
  done < <(jq -r '.plugins[][].installPath' "$user/plugins/installed_plugins.json" 2>/dev/null)

  servers=$(
    # a .mcp.json may wrap its servers in mcpServers or list them at the top level
    for f in "${mcp_files[@]}"; do jq -r '(.mcpServers // .) | keys[]' "$f" 2>/dev/null; done
    # settings only ever wrap them, and .claude.json also scopes some to one repo
    for f in "${settings[@]}" "$HOME/.claude.json"; do
      [[ -f $f ]] || continue
      jq -r --arg repo "$repo" \
        '[.mcpServers, .projects[$repo].mcpServers] | add // {} | keys[]' "$f" 2>/dev/null
    done
  ) || true
}

discover_codex() {
  local user entry name market dir markets
  user=$(agent_home codex)

  skill_locator=1
  add_tree 1 project "$repo/.codex"

  # Codex reads an AGENTS.md from the repo root down to the directory it was
  # started in, so a nested one counts too, and AGENTS.override.md takes the
  # place of AGENTS.md in its own directory
  while read -r dir; do
    if [[ -f "$dir/AGENTS.override.md" ]]; then
      add_memory 1 "$dir/AGENTS.override.md"
    else
      add_memory 1 "$dir/AGENTS.md"
    fi
  done < <(memory_dirs "$cwd" "$root")

  add_tree 2 user "$user"
  # skills kept for whatever agent is running, which Codex reads directly and
  # Claude reaches through symlinks in its own skills directory
  add_tree 2 shared "$HOME/.agents"
  add_memory 2 "$user/AGENTS.md"
  [[ -f "$user/hooks.json" ]] && hook_files+=("${user/#$HOME/\~}/hooks.json|$user/hooks.json")

  # A plugin is enabled in config.toml and unpacked under a content hash, so the
  # newest directory is the one in use. Its marketplace has to still be
  # registered: an entry naming one that is gone is stale and loads nothing,
  # cache directory or no cache directory
  markets=$(toml_sections 'marketplaces.' "$user/config.toml")
  while read -r entry; do
    name=${entry%@*}
    market=${entry#*@}
    grep -qxF "$market" <<<"$markets" || continue
    # shellcheck disable=SC2012 # a content hash sorts by nothing useful, newest wins
    dir=$(ls -td "$user/plugins/cache/$market/$name"/*/ 2>/dev/null | head -1) || true
    [[ -n $dir ]] && add_tree 2 "plugin $name" "${dir%/}"
  done < <(toml_sections 'plugins."' "$user/config.toml")

  # A nested table such as [mcp_servers.x.env] configures a server, it is not one
  servers=$(toml_sections 'mcp_servers.' "$user/config.toml" | grep -v '\.') || true
}

# Where a harness keeps its own files, written down once so the summary and the
# breakdown can never disagree about which directory that is
agent_home() { # agent
  case $1 in
    claude) printf '%s\n' "$HOME/.claude" ;;
    codex) printf '%s\n' "${CODEX_HOME:-$HOME/.codex}" ;;
    *) return 1 ;;
  esac
}

# A harness counts as installed here if it has somewhere to read from: its own
# directory in $HOME, or one in this repo
installed() { # agent
  local home
  home=$(agent_home "$1") || return 1
  [[ -d $home || -d "$repo/.$1" ]]
}

# Everything one agent puts in context, as rows. Called once per agent, so what
# discovery collects is reset each time rather than added to
collect() { # agent
targets=()
memory=()
hook_files=()
extra_events=()
servers=
strip_memory=0
listing_cap=0
skill_locator=0

# Where the memory walk starts and stops, for both agents. Physical paths, so a
# symlinked cwd still meets the root git reports and the walk stops there
cwd=$(cd "$repo" && pwd -P)
root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || root=$cwd

case $1 in
  claude)
    discover_claude
    repo_note='nothing: no CLAUDE.md, .claude/ or .mcp.json'
    ;;
  codex)
    discover_codex
    repo_note='nothing: no AGENTS.md or .codex/'
    ;;
  *)
    printf 'unknown agent %s. Supported: %s\n' "$1" "${agents[*]}" >&2
    exit 1
    ;;
esac

files=()
for target in "${targets[@]}"; do
  IFS='|' read -r _ _ kind dir <<<"$target"
  # -L because a skill is often a symlink to where it is really kept. A loose
  # file in a skills directory is not a skill, only the SKILL.md below it
  while IFS= read -r f; do files+=("$f"); done < <(
    if [[ $kind == skills ]]; then
      find -L "$dir" -mindepth 2 -type f 2>/dev/null
    else
      find -L "$dir" -mindepth 1 -type f -name '*.md' 2>/dev/null
    fi
  )
done

# One pass over every file. A description ships on every session, the rest of the
# entry file when the item fires, and the files below it only if the agent opens
# them, so each file is split across the three
rows=$(
  for entry in "${memory[@]}"; do
    path=${entry#*|}
    label=${path#"$root"/}
    printf '%s\t%s\t-\t%d\t0\t0\n' "${entry%%|*}" "${label/#$HOME/\~}" "$(memory_tokens "$path")"
  done
  if ((${#files[@]})); then awk -v b="$BYTES_PER_TOKEN" -v locator="$skill_locator" \
    -v targets="$(printf '%s;' "${targets[@]}")" '
    # An item is a skill directory, or a single command or agent file. Only its
    # entry file carries the description that ships on every session
    function classify(path,   i, rest, cut, tail, disp, plug) {
      for (i = 1; i <= n; i++) {
        if (index(path, dir[i] "/") != 1) continue
        rest = substr(path, length(dir[i]) + 2)
        if (kind[i] == "skills") {
          cut = rest
          sub(/\/.*/, "", cut)
          # a hidden directory in a skills root holds skills rather than being
          # one, which is how Codex keeps the skills it ships itself
          if (substr(cut, 1, 1) == ".") {
            tail = substr(rest, length(cut) + 2)
            if (index(tail, "/")) cut = cut "/" substr(tail, 1, index(tail, "/") - 1)
          }
          is_entry = (rest == cut "/SKILL.md")
          # Codex writes each skill into its listing as
          # "- <plugin:>name: description (file: <path>)", and the name and the
          # path are as resident as the description is
          if (is_entry && locator) {
            disp = cut
            sub(/^.*\//, "", disp)
            if (lab[i] ~ /^plugin /) {
              plug = lab[i]
              sub(/^plugin /, "", plug)
              sub(/ skills$/, "", plug)
              disp = plug ":" disp
            }
            over[sect[i] SUBSEP lab[i] SUBSEP cut] = length(path) + length(disp) + 14
          }
          return sect[i] SUBSEP lab[i] SUBSEP cut
        }
        is_entry = (rest ~ /\.md$/)
        sub(/\.md$/, "", rest)
        return sect[i] SUBSEP lab[i] SUBSEP rest
      }
      is_entry = 0
      return "" SUBSEP "other" SUBSEP path
    }
    BEGIN {
      n = split(targets, t, ";")
      for (i = 1; i <= n; i++) {
        split(t[i], f, "|")
        sect[i] = f[1]; lab[i] = f[2]; kind[i] = f[3]; dir[i] = f[4]
      }
    }
    FNR == 1 { key = classify(FILENAME); fm = 0; in_desc = 0 }
    { bytes[key] += length($0) + 1; if (is_entry) ent[key] += length($0) + 1 }
    FNR == 1 && /^---[ \t]*$/ { fm = 1; next }
    fm && /^---[ \t]*$/ { fm = 0; next }
    fm && is_entry {
      if (/^description:/) in_desc = 1
      else if (/^[A-Za-z_][A-Za-z0-9_-]*:/ || /^#/) in_desc = 0
      # a skill the model cannot invoke is not in the list it is shown, so its
      # description costs nothing until someone asks for it by name
      if (/^disable-model-invocation:[ \t]*true/) off[key] = 1
      if (in_desc) desc[key] += length($0) + 1
    }
    END {
      for (key in bytes) {
        split(key, p, SUBSEP)
        # the listing costs the description and the line it sits on, the entry
        # file costs whatever is left of itself
        shown = off[key] ? 0 : int(desc[key] / b)
        printf "%s\t%s\t%s\t%d\t%d\t%d\n", p[1], p[2], p[3],
          shown ? shown + int(over[key] / b) : 0,
          int(ent[key] / b) - shown, int((bytes[key] - ent[key]) / b)
      }
    }
  ' "${files[@]}"; fi
)
}

# The four numbers under a table, from its rows, for the table and the summary
# line alike: skills and commands share one budget and are capped together,
# everything else is resident whatever else is loaded. Prints what the listing
# wanted and what fits too
totals() { # listing_cap
  awk -F'\t' -v cap="$1" '
    NF < 6 { next }
    { if ($2 ~ /(skills|commands)$/) listing += $4; else always += $4
      trigger += $5; demand += $6; if ($3 != "-") items++ }
    END {
      shown = (cap && listing > cap) ? cap : listing
      printf "%d\t%d\t%d\t%d\t%d\t%d\n", always + shown, trigger, demand, items, listing, shown
    }
  '
}

# The label column is as wide as the longest name in the table, so one long
# plugin name widens the table instead of shifting its row. Between 30 and 44,
# past which an absolute path outside $HOME keeps its tail and loses its head
width='function width(s,   n) { n = length(s) > 44 ? 44 : length(s); return n > w ? n : w }
function fit(s, m) { if (!m) m = w
  return length(s) <= m ? s : "..." substr(s, length(s) - m + 4) }'

# Ten cells over the window, a half block from 5% of a cell, coloured by absolute
# tokens the way the status line does: green to 100k, then yellow, then red past
# 600k. Only always is ever drawn — on read is a ceiling nobody reaches, so a bar
# over it would say nothing
bar='function bar(v,   p, full, half, i, s) {
  p = pct(v); full = int(p / 10); half = (full < 10 && p - full * 10 >= 5)
  for (i = 0; i < full; i++) s = s "█"
  if (half) s = s "▌"
  for (i = full + half; i < 10; i++) s = s " "
  return s
}
function pct(v) { return v * 100 / window > 100 ? 100 : v * 100 / window }
function heat(v) { return v <= 100000 ? gr : (v <= 600000 ? y : rd) }'

commify='function commify(n,   s, out) {
  s = sprintf("%d", n); out = ""
  while (length(s) > 3) { out = "," substr(s, length(s) - 2) out; s = substr(s, 1, length(s) - 3) }
  return s out
}'

# The three token columns every table shares, and the note under a table whose
# listing ran over its budget. A dash rather than a zero: nothing to load reads
# differently from something that loads for free
cols='function cols(va, vt, vd) {
  return sprintf("%s%9s%s  %s%10s%s  %s%10s%s", gr, commify(va), r,
    y, (vt ? commify(vt) : "-"), r, y, (vd ? commify(vd) : "-"), r)
}'

capnote='function capnote(want, fits) {
  if (fits < want)
    printf "  %s∟ %s in skill and command descriptions, capped at %s by the listing budget%s\n",
      g, commify(want), commify(fits), r
}'

# The disk says nothing about the instructions an agent writes for itself, and
# codex will render the prompt it would send from here, which is the one place
# those blocks can be measured
if ((show_prompt)); then
  ((agent_set)) || agent=codex
  [[ $agent == codex ]] || {
    printf 'only codex can render its prompt outside a session. In Claude Code, /context breaks down the same thing\n' >&2
    exit 1
  }
  command -v codex >/dev/null || {
    printf 'agent-ctx --prompt needs the codex binary on PATH\n' >&2
    exit 1
  }
  blocks=$(codex debug prompt-input 2>/dev/null |
    jq -r '[.. | objects | .text? | select(type == "string")]
      | map({ n: ((capture("^[ \n]*<(?<t>[a-z_ ]+)>").t)? // (sub("^[ \n]+"; "") | split("\n")[0] | sub("^#+ +"; "") | .[0:36])), c: length })
      | sort_by(-.c)[] | [.n, .c] | @tsv') || true
  [[ -n $blocks ]] || {
    printf 'codex debug prompt-input returned nothing to measure\n' >&2
    exit 1
  }
  printf '%s%s%s %s(codex) what it would send from here, before you type%s\n\n' \
    "$BRIGHT" "$repo" "$RESET" "$GRAY" "$RESET"
  awk -F'\t' -v b="$BYTES_PER_TOKEN" -v g="$GRAY" -v gr="$GREEN" -v y="$YELLOW" -v r="$RESET" \
    -v bt="$BRIGHT" "$commify"'
    { n++; lab[n] = $1; c[n] = $2; total += $2 }
    END {
      printf "%s%-38s%11s  %10s%s\n", g, "block", "chars", "tokens", r
      for (i = 1; i <= n; i++)
        printf "  %-36s %s%11s%s  %s%10s%s\n", substr(lab[i], 1, 36),
          gr, commify(c[i]), r, y, commify(int(c[i] / b)), r
      for (i = 0; i < 60; i++) rule = rule "─"
      printf "  %s%s%s\n", g, rule, r
      printf "  %-36s %s%11s%s  %s%10s%s\n", "total",
        bt gr, commify(total), r, bt y, commify(int(total / b)), r
    }
  ' <<<"$blocks"
  exit 0
fi

# Without -a there is no one harness to break down, so each one installed here
# gets the line its own table ends with
if ((agent_set == 0 && verbose == 0)) && [[ -z $filter ]]; then
  summary=$(
    for a in "${agents[@]}"; do
      installed "$a" || continue
      collect "$a"
      printf '%s\t%s\n' "$a" "$(totals "$listing_cap" <<<"$rows")"
    done
  )
  [[ -n $summary ]] || {
    printf 'no claude or codex directory here or in %s\n' "$HOME" >&2
    exit 1
  }
  # the flags name the harnesses actually found, so the hint never offers one
  # that is not installed here
  hint=$(awk -F'\t' -v c="$CYAN" -v g="$GRAY" \
    '{ h = h (n++ ? g " or " : "") c "-a " $1 } END { print h }' <<<"$summary")
  printf '%s%s%s\n%sestimated tokens at 3 bytes each. %s%s breaks one down%s\n\n' \
    "$BRIGHT" "$repo" "$RESET" "$GRAY" "$hint" "$GRAY" "$RESET"
  awk -F'\t' -v b="$BRIGHT" -v g="$GRAY" -v gr="$GREEN" -v y="$YELLOW" -v r="$RESET" -v rd="$RED" \
    -v bg="$BG" -v window="$window" -v wlabel="$window_label" \
    "$commify$bar$capnote"'
    { n++; a[n] = $1; va[n] = $2; vt[n] = $3; vd[n] = $4; vi[n] = $5; li[n] = $6; sh[n] = $7 }
    END {
      printf "  %s%-8s %-10s  %-14s %9s  %10s  %10s  %5s%s\n", g,
        "harness", "", "", "always", "on trigger", "on read", "items", r
      for (i = 1; i <= n; i++) {
        fill = sprintf("%.0f%% of %s", pct(va[i]), wlabel)
        printf "  %s%-8s%s %s%s%s%s  %s%-14s%s %s%9s%s  %s%10s%s  %s%10s%s  %5s\n",
          b, a[i], r, heat(va[i]), bg, bar(va[i]), r, g, fill, r,
          b heat(va[i]), commify(va[i]), r, b y, commify(vt[i]), r,
          b y, commify(vd[i]), r, vi[i]
        capnote(li[i], sh[i])
      }
    }
  ' <<<"$summary"
  exit 0
fi

collect "$agent"

if [[ -n $filter ]]; then
  # a filter can match several groups, so keep each one together and labelled
  matched=$(awk -F'\t' -v f="$filter" 'index($2, f) && $3 != "-"' <<<"$rows" |
    sort -t$'\t' -k2,2 -k5,5nr -k6,6nr)
  if [[ -z $matched ]]; then
    printf 'no %s group matching %s. Run agent-ctx with no argument to list them\n' "$agent" "$filter" >&2
    exit 1
  fi
  awk -F'\t' -v b="$BRIGHT" -v g="$GRAY" -v gr="$GREEN" -v y="$YELLOW" -v r="$RESET" -v w=30 \
    "$commify$width$cols"'
    { n++; grp[n] = $2; lab[n] = $3; va[n] = $4; vt[n] = $5; vd[n] = $6; w = width($3) }
    END {
      for (i = 1; i <= n; i++) {
        if (grp[i] != group) {
          if (group != "") print ""
          group = grp[i]
          printf "%s%-*s%s%s%9s  %10s  %10s%s\n", b, w + 3, group, r, g,
            "always", "on trigger", "on read", r
        }
        printf "  %-*s %s\n", w, fit(lab[i]), cols(va[i], vt[i], vd[i])
      }
    }
  ' <<<"$matched"
  exit 0
fi

printf '%s%s%s %s(%s)%s\n%sestimated tokens at 3 bytes each. On trigger is the rest of the entry file,%s\n%son read a ceiling: every byte in the files it can open%s\n\n' \
  "$BRIGHT" "$repo" "$RESET" "$GRAY" "$agent" "$RESET" "$GRAY" "$RESET" "$GRAY" "$RESET"

# A repo that adds nothing still deserves the line saying so
grep -q '^1	' <<<"$rows" || rows=$'1\t-\t-\t0\t0\t0\n'$rows

# With -v a group also lists what is in it, heaviest first, so the table says
# which skill the tokens went to rather than only which directory. The count of
# items is what the items themselves are standing in for, so that column goes
detail=
((verbose)) && detail=$(awk -F'\t' 'NF >= 6 && $3 != "-"' <<<"$rows" |
  sort -t$'\t' -k1,1 -k2,2 -k4,4nr -k5,5nr)

IFS=$'\t' read -r always trigger demand items listing shown \
  < <(totals "$listing_cap" <<<"$rows")

awk -F'\t' -v b="$BRIGHT" -v g="$GRAY" -v gr="$GREEN" -v y="$YELLOW" -v r="$RESET" -v note="$repo_note" \
  -v w=30 -v rd="$RED" -v bg="$BG" -v window="$window" -v wlabel="$window_label" \
  -v verbose="$verbose" -v always="$always" -v trigger="$trigger" -v demand="$demand" \
  -v items="$items" -v listing="$listing" -v shown="$shown" \
  "$commify$width$bar$cols$capnote"'
  # first file is the items, kept in print order under the row they belong to
  FNR == NR {
    if (NF < 4 || !verbose) next
    item[$1 SUBSEP $2] = item[$1 SUBSEP $2] $3 "\t" $4 "\t" $5 "\t" $6 "\n"
    w = width("  " $3)
    next
  }
  { n++; sec[n] = $1; lab[n] = $2; va[n] = $3; vt[n] = $4; vd[n] = $5; vi[n] = $6
    if ($2 != "-") w = width($2) }
  END {
    for (i = 1; i <= n; i++) {
      if (sec[i] != section) {
        if (section != "") print ""
        section = sec[i]
        name = (section == 1 ? "this repo" : "inherited")
        printf "%s%-*s%s%s%9s  %10s  %10s%s%s\n", b, w + 3, name, r, g,
          "always", "on trigger", "on read", (verbose ? "" : sprintf("  %5s", "items")), r
      }
      if (lab[i] == "-") { print "  " note; continue }
      printf "  %-*s %s%s\n", w, fit(lab[i]), cols(va[i], vt[i], vd[i]),
        (verbose ? "" : sprintf("  %5s", vi[i] ? vi[i] : "-"))
      if (!verbose) continue
      m = split(item[sec[i] SUBSEP lab[i]], it, "\n")
      for (j = 1; j < m; j++) {
        split(it[j], c, "\t")
        # the connector is printed outside the padded field: under LC_ALL=C it
        # is three bytes, and awk would pad it as three columns
        printf "  %s%s %-*s%s %s\n",
          g, (j == m - 1 ? "└" : "├"), w - 2, fit(c[1], w - 2), r,
          cols(c[2], c[3], c[4])
      }
    }

    for (i = 0; i < w + (verbose ? 34 : 41); i++) rule = rule "─"
    printf "  %s%s%s\n", g, rule, r

    fill = sprintf("%.0f%% of %s", pct(always), wlabel)

    # Padded by cells rather than by %-38s: under LC_ALL=C a block is three
    # bytes, so awk would count the bar as thirty columns wide
    pad = w - 18 - length(fill); if (pad < 1) pad = 1
    printf "  total  %s%s%s%s  %s%s%s%*s%s%9s%s  %s%10s%s  %s%10s%s%s\n",
      heat(always), bg, bar(always), r, g, fill, r, pad, "",
      b heat(always), commify(always), r, b y, commify(trigger), r,
      b y, commify(demand), r, (verbose ? "" : sprintf("  %5s", items + 0))

    capnote(listing, shown)
  }
' <(printf '%s\n' "$detail") \
  <(awk -F'\t' 'NF < 6 { next }
    { a[$1 "\t" $2] += $4; t[$1 "\t" $2] += $5; d[$1 "\t" $2] += $6; if ($3 != "-") n[$1 "\t" $2]++ }
    END { for (k in a) printf "%s\t%d\t%d\t%d\t%d\n", k, a[k], t[k], d[k], n[k] }' <<<"$rows" |
    sort -t$'\t' -k1,1 -k3,3nr -k4,4nr -k5,5nr)

events=$(
  for entry in "${hook_files[@]}"; do
    # @tsv rather than a sed replacement: the separator is a real tab whatever
    # sed is on the box, and the source is jq data rather than something an & or
    # a backslash in a plugin name could rewrite
    jq -r --arg s "${entry%%|*}" '.hooks // {} | keys[] | [., $s] | @tsv' "${entry#*|}" 2>/dev/null
  done
  if ((${#extra_events[@]})); then printf '%s\n' "${extra_events[@]}"; fi
) || true
if [[ -n $events ]]; then
  printf '\n%s%s%s %snot resident, injected when it fires%s\n' "$BRIGHT" "per event" "$RESET" "$GRAY" "$RESET"
  sort -u <<<"$events" | while IFS=$'\t' read -r event source; do
    printf '  %-24s %s%s%s\n' "$event" "$GRAY" "$source" "$RESET"
  done
fi

# Tool schemas are the one eager cost nothing on disk knows: no transcript records
# them, so only a live session can add them up
servers=$(sort -u <<<"$servers" | tr '\n' ' ')
if [[ -n ${servers// /} ]]; then
  printf '\n%s%s%s %sschemas ship every session, size only in /context%s\n  %s%s%s\n' \
    "$BRIGHT" "mcp servers" "$RESET" "$GRAY" "$RESET" "$CYAN" "${servers% }" "$RESET"
fi
