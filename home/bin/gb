#!/usr/bin/env bash

# Git branches with formatted output, newest first

set -e

usage() {
  cat <<'USAGE'
gb - list git branches, most recently committed to first

Usage: gb [-r] [-s] [-h]

Options:
  -r  remote branches instead of local
  -s  name and size only, largest first. Size is the disk taken by the objects
      a branch holds that origin's default branch does not, so a branch with
      nothing of its own is left blank
  -h  show this help and exit

The current branch is shown as a block, a tick marks the branches already
merged into HEAD. On a repo with more than three recent contributors each
author gets their own colour, the same one gl gives them and the same one
tomorrow: the assignment is kept in .git. Two dozen colours, so on a crowded
repo the rest of the names stay plain.
USAGE
}

# Colors (using $'...' syntax for proper escape interpretation)
RESET=$'\033[0m'
BRIGHT=$'\033[1m'
GRAY=$'\033[90m'
LIGHT_GRAY=$'\033[38;5;246m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
WHITE=$'\033[37m'
BLOCK=$'\033[7m'

# Author colours, kept: the colour a name has been given stays with it, so the
# one you have learned does not move when a new author turns up or when someone
# has a busy week. .git/author-colors holds the assignment and both gb and gl
# read it and top it up, which is what makes the two agree. The palette skips
# commit yellow and branch green, so a name never reads as a sha or a branch,
# and its twenty four are picked for distance in CIELAB
AUTHOR_COLORS=(208 165 215 99 196 45 197 31 198 75 209 69 180 171 167 134 217 199 110 213 104 211 183 169)
AUTHOR_MIN=3       # at or below this the column reads fine in one colour
AUTHOR_SAMPLE=1000 # commits to take the names from

# Prints "name<TAB>colour" a line for the names that hold a colour. Latest
# first, so where there are more people than colours the names at the top of
# the log are served first, and a colour only ever comes back from a name the
# sample no longer holds
author_colors() {
  local common store sample name changed='' i held=()

  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  store=$common/author-colors
  sample=$(git log -n "$AUTHOR_SAMPLE" --format='%an' 2>/dev/null | awk '!seen[$0]++')
  (($(printf '%s\n' "$sample" | grep -c .) > AUTHOR_MIN)) || return 0

  if [[ -r "$store" ]]; then
    while IFS=$'\t' read -r i name; do
      [[ "$i" =~ ^[0-9]+$ && -n "$name" ]] && held[i]=$name
    done <"$store"
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ "${held[i]}" == "$name" ]] && continue 2
    done
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ -n "${held[i]}" && $'\n'"$sample"$'\n' == *$'\n'"${held[i]}"$'\n'* ]] && continue
      held[i]=$name
      changed=1
      continue 2
    done
  done <<<"$sample"

  # Written beside the store and moved onto it, so a second gb or gl reading
  # while this one writes sees the old file or the new one, never half of each.
  # A repo that cannot be written to still gets its colours, just not kept ones
  if [[ -n "$changed" && -w "$common" ]]; then
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ -n "${held[i]}" ]] && printf '%s\t%s\n' "$i" "${held[i]}"
    done >"$store.$$"
    mv -f "$store.$$" "$store" 2>/dev/null || rm -f "$store.$$"
  fi

  # Colour first: a name is free to hold a tab of its own, and everything
  # after the first one is the name
  for i in "${!AUTHOR_COLORS[@]}"; do
    [[ -n "${held[i]}" ]] && printf '%s\t%s\n' "${AUTHOR_COLORS[i]}" "${held[i]}"
  done
  return 0
}

# Biggest first, then the byte count becomes KiB or MiB as git would write it.
# A branch holding nothing the base lacks measures 0, and says more left blank
by_size() {
  [[ -z "$sizes" ]] && { cat; return; }
  sort -rn | awk -F'\t' -v gray="$GRAY" -v reset="$RESET" '
    BEGIN { split("B KiB MiB GiB TiB", unit, " ") }
    {
      sz = $1
      for (i = 1; sz >= 1024 && i < 5; i++) sz /= 1024
      size = $1 == 0 ? "" : (i == 1 ? sprintf("%d B", sz) : sprintf("%.2f %s", sz, unit[i]))
      printf "%s%s%10s%s\n", $2, gray, size, reset
    }'
}

truncate() { ((${#1} > $2)) && printf '%s…' "${1:0:$2}" || printf '%s' "$1"; }

refs=refs/heads
sizes=""
# Leading colon: getopts stays quiet so the unknown option reads as ours
while getopts :rsh opt; do
  case $opt in
    r) refs=refs/remotes ;;
    s) sizes=1 ;;
    h) usage && exit 0 ;;
    *) echo "gb: unknown option -$OPTARG" >&2 && usage >&2 && exit 2 ;;
  esac
done

# -s prints no names, so it does none of this
author_names=()
author_codes=()
if [[ -z "$sizes" ]]; then
  while IFS=$'\t' read -r code name; do
    author_names+=("$name")
    author_codes+=("$code")
  done < <(author_colors)
fi

# What a branch is measured against: what origin calls default, else this branch
if [[ -n "$sizes" ]]; then
  base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) ||
    base=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
fi

# One call for everything: sorted, symref first to skip pointers like
# origin/HEAD. Unit separator, a ref or an author name may contain a pipe
sep=$'\037'
sorted_data=$(git for-each-ref --sort=-committerdate \
  --format="%(symref)$sep%(refname:short)$sep%(objectname:short=8)$sep%(authorname)$sep%(committerdate:relative)$sep%(committerdate:unix)$sep%(committerdate:format:%d %b %Y)$sep%(contents:subject)" \
  "$refs" 2>/dev/null) || exit 0

[[ -z "$sorted_data" ]] && exit 0

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Branches whose tip is an ancestor of HEAD, one call instead of one per branch
merged=$'\n'$(git for-each-ref --merged=HEAD --format='%(refname:short)' "$refs" 2>/dev/null)$'\n'

# Calculate max branch name length
max_branch_len=0
while IFS="$sep" read -r symref branch _; do
  [[ -n "$symref" ]] && continue
  [[ ${#branch} -gt $max_branch_len ]] && max_branch_len=${#branch}
done <<<"$sorted_data"

# Output
now=$(date +%s)

while IFS="$sep" read -r symref branch sha author timeago ts stamp message; do
  [[ -z "$branch" || -n "$symref" ]] && continue

  is_present=""
  [[ "$merged" == *$'\n'"$branch"$'\n'* ]] && is_present="1"

  is_current=""
  [[ "$branch" == "$current_branch" ]] && is_current="1"

  # Determine marker. The current branch needs none, its block says so
  marker=" "
  [[ -n "$is_present" && -z "$is_current" ]] && marker="${GREEN}✓${RESET}"

  # Determine SHA color
  sha_color="$YELLOW"
  [[ -n "$is_current" ]] && sha_color="$BRIGHT"

  # The current branch gets a block. Every name carries the same space each side
  # so the block has room without shifting the columns
  branch_color="$GREEN"
  [[ -n "$is_current" ]] && branch_color="$BLOCK"
  branch_field=$(printf '%s %s %s%*s' \
    "$branch_color" "$branch" "$RESET" $((max_branch_len - ${#branch})) '')

  # Months read better than "1 year, 4 months", a date is better than either.
  # (days + 15) / 30 is how git itself rounds months, so the two agree
  days=$(((now - ts) / 86400))
  if ((days > 730)); then
    timeago="$stamp"
  elif ((days >= 30)); then
    timeago="$(((days + 15) / 30)) months ago"
  fi

  # -s is a different question, so it gets its own line: the name and the size,
  # nothing else. Raw bytes here, by_size sorts on them and formats them
  if [[ -n "$sizes" ]]; then
    bytes=$(git rev-list --disk-usage --objects "$branch" --not "$base" 2>/dev/null) || bytes=0
    printf '%s\t%s %s\n' "$bytes" "$marker" "$branch_field"
    continue
  fi

  # Truncate fields. timeago needs none, %-15s already pads its longest form
  author_trunc=$(truncate "$author" 20)
  # The whole name, not the truncated one, so gl agrees on the colour. A name
  # without one, because the repo is small or the colours are all spoken for,
  # stays the plain white it always was
  author_col="$WHITE"
  for i in "${!author_names[@]}"; do
    [[ "$author" == "${author_names[i]}" ]] || continue
    author_col=$'\033[38;5;'${author_codes[i]}m
    break
  done
  message_trunc=$(truncate "$message" 60)

  # Use %b to interpret escape sequences in format string
  printf '%s %s %b%s%b  %b%-15s%b  %b%s → %b%s%b\n' \
    "$marker" \
    "$branch_field" \
    "$sha_color" "$sha" "$RESET" \
    "$GRAY" "$timeago" "$RESET" \
    "$author_col" "$author_trunc" \
    "$LIGHT_GRAY" "$message_trunc" "$RESET"
  # -F skips the pager when it all fits on one screen, -X keeps it on screen
done <<<"$sorted_data" | by_size |
  less -RFX --lesskey-content='#command;q quit x' || pager=$?

# q returns 120 so the next prompt can replace one whole entry instead of
# scrolling the first entry away. -F still leaves short output untouched.
# The || above also keeps set -e from ending the script on that 120
if ((pager == 120)); then printf '\033[2A\r\033[J'; fi

exit 0
