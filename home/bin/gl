#!/usr/bin/env bash

# Git log, one line per commit, refs on a continuation line
# Usage: gl [git log options]

# %+ emits the ref line, prefix and all, only when the commit has refs. git can
# only append it, so awk swaps the pair to put the refs above their commit. less
# drops colour at every line break, so that line restarts its own colours, and
# it eats the byte after a colour code, so no colour ever precedes the marker.
marker='┍'
white='%x1b[37m'
green='%x1b[32m'

# Author colours, kept: the colour a name has been given stays with it, so the
# one you have learned does not move when a new author turns up or when someone
# has a busy week. .git/author-colors holds the assignment and both gb and gl
# read it and top it up, which is what makes the two agree. The palette skips
# commit yellow and branch green, so a name never reads as a sha or a branch,
# and its twenty four are picked for distance in CIELAB
AUTHOR_COLORS=(208 165 215 99 196 45 197 31 198 75 209 69 180 171 167 134 217 199 110 213 104 211 183 169)
AUTHOR_MIN=3       # at or below this the column reads fine in one colour
AUTHOR_SAMPLE=1000 # commits to take the names from

# Prints "name<TAB>colour" a line for the names that hold a colour. Latest
# first, so where there are more people than colours the names at the top of
# the log are served first, and a colour only ever comes back from a name the
# sample no longer holds
author_colors() {
  local common store sample name changed='' i held=()

  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  store=$common/author-colors
  sample=$(git log -n "$AUTHOR_SAMPLE" --format='%an' 2>/dev/null | awk '!seen[$0]++')
  (($(printf '%s\n' "$sample" | grep -c .) > AUTHOR_MIN)) || return 0

  if [[ -r "$store" ]]; then
    while IFS=$'\t' read -r i name; do
      [[ "$i" =~ ^[0-9]+$ && -n "$name" ]] && held[i]=$name
    done <"$store"
  fi

  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ "${held[i]}" == "$name" ]] && continue 2
    done
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ -n "${held[i]}" && $'\n'"$sample"$'\n' == *$'\n'"${held[i]}"$'\n'* ]] && continue
      held[i]=$name
      changed=1
      continue 2
    done
  done <<<"$sample"

  # Written beside the store and moved onto it, so a second gb or gl reading
  # while this one writes sees the old file or the new one, never half of each.
  # A repo that cannot be written to still gets its colours, just not kept ones
  if [[ -n "$changed" && -w "$common" ]]; then
    for i in "${!AUTHOR_COLORS[@]}"; do
      [[ -n "${held[i]}" ]] && printf '%s\t%s\n' "$i" "${held[i]}"
    done >"$store.$$"
    mv -f "$store.$$" "$store" 2>/dev/null || rm -f "$store.$$"
  fi

  # Colour first: a name is free to hold a tab of its own, and everything
  # after the first one is the name
  for i in "${!AUTHOR_COLORS[@]}"; do
    [[ -n "${held[i]}" ]] && printf '%s\t%s\n' "${AUTHOR_COLORS[i]}" "${held[i]}"
  done
  return 0
}

authors=$(author_colors)

current_branch=$(git symbolic-ref -q --short HEAD 2>/dev/null)
merged_branches=$(git for-each-ref --merged=HEAD \
  --format='%(refname:short)' refs/heads 2>/dev/null | tr '\n' '\034')

# The date and the author arrive between two %x1f markers, split on %x1e: git
# can pick neither the date to show nor a colour per author name itself
git log --color=always --abbrev=8 --date=format:'%d %b %Y' \
  --pretty=format:"%C(yellow)%h %C(59)%x1f%ct%x1e%cd%x1e%cr%x1e%an%x1f → %C(245)%s%+(decorate:prefix=$marker $green,pointer=$white -> $green,separator=$white%x2C $green,suffix=$white)%C(auto)" \
  "$@" |
  gl_authors="${authors//$'\n'/$'\034'}" \
    awk -v now="$(date +%s)" -v marker="$marker" \
    -v merged="$merged_branches" -v current="$current_branch" '
    # (days + 15) / 30 is how git itself rounds months, so the two agree
    BEGIN {
      sep = sprintf("%c", 31)
      esc = sprintf("%c", 27)
      green = esc "[32m"
      white = esc "[37m"
      yellow = esc "[33m"
      bright = esc "[1m"
      branch_count = split(merged, branches, sprintf("%c", 28))
      fsep = sprintf("%c", 30)
      # Name and colour a line, as git-author-colors prints them. A name it
      # gives none, because the repo is small or the colours are all spoken
      # for, has no entry here and stays plain white.
      # ENVIRON, not -v: awk reads an escape sequence out of a -v value, and a
      # backslash in a name would stop it matching the one gb colours
      count = split(ENVIRON["gl_authors"], lines, sprintf("%c", 28))
      for (i = 1; i <= count; i++) {
        t = index(lines[i], "\t")
        if (t)
          author_color[substr(lines[i], t + 1)] = \
            esc "[38;5;" substr(lines[i], 1, t - 1) "m"
      }
    }
    {
      a = index($0, sep)
      if (a) {
        b = index(substr($0, a + 1), sep) + a
        split(substr($0, a + 1, b - a - 1), f, fsep)
        days = int((now - f[1]) / 86400)
        when = days > 730 ? f[2] : (days >= 30 ? int((days + 15) / 30) " months ago" : f[3])
        color = author_color[f[4]]
        $0 = substr($0, 1, a - 1) sprintf("%-15s", when) white \
          (color == "" ? f[4] : color f[4] white) substr($0, b + 1)
      }
      for (i = 1; i <= branch_count; i++) {
        if (branches[i] != "" && branches[i] != current) {
          needle = green branches[i] white
          if (at = index($0, needle)) {
            $0 = substr($0, 1, at - 1) green "✓ " branches[i] white \
              substr($0, at + length(needle))
          }
        }
      }
      # The ref line is the only one starting with the marker, and it arrives
      # after its commit, so hold each commit until the next line decides
      if (index($0, marker) == 1) {
        # HEAD -> marks the current branch, so its commit takes the bright
        # sha gb uses, bold cleared again before the columns after it
        if (index($0, green "HEAD" white " -> ") &&
            substr(hold, 1, length(yellow)) == yellow) {
          rest = substr(hold, length(yellow) + 1)
          at = index(rest, esc)
          hold = bright substr(rest, 1, at - 1) esc "[22m" substr(rest, at)
        }
        print
        if (hold != "") print hold
        hold = ""
        next
      }
      if (hold != "") print hold
      hold = $0
    }
    END { if (hold != "") print hold }
  ' |
  sed $'s/\033\\[32mHEAD\033\\[37m -> \033\\[32m\\([^\033]*\\)\033\\[37m/\033[7m \\1 \033[m\033[37m/' |
  less -RFX --lesskey-content='#command;q quit x'

statuses=("${PIPESTATUS[@]}")

# q returns 120 so the next prompt can replace one whole entry instead of
# scrolling the first entry away. -F still leaves short output untouched.
((statuses[3] == 120)) && printf '\033[2A\r\033[J'

# Report git's own failures, less exiting first is not one of them
status=${statuses[0]}
((status == 141)) && status=0
exit "$status"
