#!/usr/bin/env bash

# XTERM 256 colour test chart
# Originally by entheon, rewritten in bash

if [[ "$1" == -h || "$1" == --help ]]; then
  cat <<'EOF'
Usage: color-test [-w]

Prints xterm colours 16-255 with their hex values.
  -w   wide display, six columns
EOF
  exit 0
fi

# 16-231 is a 6x6x6 cube over these levels, 232-255 a grey ramp of 8+10i. Same
# numbers the chart has always printed, without carrying 240 literals.
levels=(00 5f 87 af d7 ff)

hex() {
  local n=$1 i grey
  if ((n < 232)); then
    i=$((n - 16))
    printf '%s/%s/%s' "${levels[i / 36]}" "${levels[i / 6 % 6]}" "${levels[i % 6]}"
  else
    grey=$((8 + 10 * (n - 232)))
    printf '%02x/%02x/%02x' "$grey" "$grey" "$grey"
  fi
}

# ponytail: dropped the original -r and -s flags and the diagonal column shuffle
# they fed. Index order is the same chart. Add them back if a shuffled one helps.
cols=1
[[ "$1" == -w ]] && cols=6

echo
for n in {16..255}; do
  printf '\e[38;5;%dm  %3d: %s' "$n" "$n" "$(hex "$n")"
  (((n - 15) % cols == 0)) && echo
done
printf '\e[0m\n'
